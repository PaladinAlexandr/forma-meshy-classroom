# Local development: DEBUG=1 + demo + SQLite. Do not commit your real .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
APP_TIME_ZONE=Asia/Yekaterinburg
MESHY_MODE=demo
MESHY_API_KEY=
MESHY_AI_MODEL=meshy-7.1
MESHY_ASSET_HOSTS=assets.meshy.ai

# Production with Docker Compose: set DEBUG=0, domain, secure key and passwords.
# APP_DOMAIN=classroom.example.org
# DJANGO_ALLOWED_HOSTS=classroom.example.org
# CSRF_TRUSTED_ORIGINS=https://classroom.example.org
# DJANGO_SECRET_KEY=<random secret, at least 40 characters>
# POSTGRES_PASSWORD=<random password>
# POSTGRES_DB=studio
# POSTGRES_USER=studio
# MESHY_MODE=live
# MESHY_API_KEY=<your API key, only here>
