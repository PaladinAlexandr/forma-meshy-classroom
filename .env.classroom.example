# Copy to .env.classroom. This is a NEW deployment with its own data volumes.
# Use your server's LAN IPv4 address, without https:// and without a port.
CLASSROOM_HOST=192.168.1.50
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
APP_TIME_ZONE=Asia/Yekaterinburg

# Start in demo to test ordinary user accounts without spending credits.
# Set live after the end-to-end demo has passed and add your Meshy API key.
MESHY_MODE=demo
MESHY_API_KEY=
MESHY_AI_MODEL=meshy-7.1
MESHY_ASSET_HOSTS=assets.meshy.ai
